  title: Last Submarine Recording
  titleId: world.Last_Submarine_Recording.title
  bodyId: world.Last_Submarine_Recording.body
  body: 'FRAME 01: repeated sonar pulses. The creature turns toward the array. FRAME
    02: the discharge pump ruptures. Divers escape while the animal circles the machinery.
    RECORDER: It follows the noise. This black box contains the original timestamps.
    Removing it will start emergency power. Follow the return beacons.'
  destination: {fileID: 0}
  requiredPropId: 
  menuCommand: 
